# --- LLM (via LangChain's ChatGroq) ---
# laptop = small defaults for an 8 GB CPU-only machine (the field defaults).
# server = larger retrieval/context/concurrency limits; explicit env vars win.
PROFILE=laptop
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Dedicated model used only as the RAGAS judge; keep it JSON-reliable and
# separate from the production model above.
RAGAS_JUDGE_MODEL=openai/gpt-oss-120b
# Determinism for reproducible demos: temperature 0 with a fixed seed makes
# routing/grading/generation stable across runs and environments.
GROQ_TEMPERATURE=0.0
GROQ_SEED=42
# OpenAI-compatible endpoint. Set LLM_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Ollama's OpenAI-compatible endpoint; use only a 1B-3B development model.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# --- Vector store (LlamaIndex's QdrantVectorStore wraps this) ---
# Empty QDRANT_URL = embedded local Qdrant (.cache/qdrant), no server needed.
# Set it to a server URL (e.g. http://localhost:6333 via `docker compose up -d`)
# to use remote Qdrant, recommended for collections larger than ~20,000 points.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_system

# --- Embeddings / reranker (LlamaIndex HuggingFaceEmbedding, CPU) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_BATCH_SIZE=64
# true = never download a model (offline/laptop). Set false once when running
# the Docker ingest service so the model can fill the shared cache volume.
EMBEDDING_LOCAL_FILES_ONLY=true
# Keep false on an 8 GB CPU-only laptop. Enable only when you have spare RAM.
ENABLE_RERANKER=false

# --- Retrieval tuning ---
# bm25 orders chunks by keyword score; rrf fuses dense and BM25 by rank. Dense search
# runs either way, because the evidence check needs its score. Re-run
# scripts/calibrate_evidence.py before changing this or the embedding model.
RETRIEVAL_RANKING=bm25
TOP_K_DENSE=8
TOP_K_SPARSE=8
TOP_K_RERANKED=3
# Extra retrievals for a question whose evidence stays weak after any escalation.
# The answer then states what it could not cover.
MAX_RETRIES=1
MAX_QUESTION_CHARS=1000
MAX_CONTEXT_CHARS=7000
MAX_SUB_QUESTIONS=2
MAX_CONCURRENT_QUERIES=1
MAX_OUTPUT_TOKENS=768
# The whole request's deadline, including every provider attempt.
REQUEST_TIMEOUT_SECONDS=45
# A query counts as covered when its best cosine similarity reaches this. It
# depends on the embedding model: re-run scripts/calibrate_evidence.py after a change.
EVIDENCE_MIN_DENSE_SCORE=0.40
# Share of a cited sentence's content words that must appear in its cited chunks.
CITATION_MIN_SUPPORT=0.2
# Load the index and retriever at startup; readiness stays 503 until that finishes.
WARMUP_ON_STARTUP=true

# --- LLM resilience ---
# Tried in order after LLM_PROVIDER's model, as provider:model,provider:model.
# Both defaults use Groq, so this covers a per-model rate limit but not an outage.
LLM_FALLBACK_CHAIN=groq:openai/gpt-oss-20b
# Must leave time for the next model within REQUEST_TIMEOUT_SECONDS.
LLM_ATTEMPT_TIMEOUT_SECONDS=12
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MIN_CALL_SECONDS=2
LLM_MAX_ATTEMPTS_PER_PROVIDER=2
LLM_MAX_CALLS_PER_QUERY=6
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RESET_SECONDS=30
# Shared daily budget, kept below the provider's limit. 0 means unlimited. Once it
# is spent the service answers by quoting retrieved passages.
LLM_DAILY_TOKEN_BUDGET=180000
LLM_DAILY_REQUEST_BUDGET=900
LLM_QUOTA_PATH=.cache/quota

# --- Observability ---
METRICS_ENABLED=true
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
# false sends text lengths instead of questions and passages.
LANGFUSE_CAPTURE_CONTENT=false
# true sends the question and final answer on the query entry, next to their
# lengths, even when the setting above is false. Set false for shared demos.
LANGFUSE_CAPTURE_QUERY_TEXT=true

# Keep false for local development. Production must set a strong API_KEY and
# use an upstream TLS proxy; claims below are fixed for this simple API-key mode.
REQUIRE_AUTH=false
API_KEY=
AUTH_TENANT_ID=tenant-demo
AUTH_ROLES=public
INDEX_VERSION=v1
