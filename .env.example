# --- LLM (via LangChain's ChatGroq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Dedicated model used only as the RAGAS judge; keep it JSON-reliable and
# separate from the production model above.
RAGAS_JUDGE_MODEL=openai/gpt-oss-120b
# Determinism for reproducible demos: temperature 0 with a fixed seed makes
# routing/grading/generation stable across runs and environments.
GROQ_TEMPERATURE=0.0
GROQ_SEED=42

# --- Vector store (LlamaIndex's QdrantVectorStore wraps this) ---
# Empty QDRANT_URL = embedded local Qdrant (.cache/qdrant), no server needed.
# Set it to a server URL (e.g. http://localhost:6333 via `docker compose up -d`)
# to use remote Qdrant, recommended for collections larger than ~20,000 points.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_system

# --- Embeddings / reranker (LlamaIndex HuggingFaceEmbedding, CPU) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval tuning ---
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_RERANKED=5
# Retries granted to the grade→retrieve loop on the simple route before the
# graph falls back to a "don't know" answer.
MAX_RETRIES=2
